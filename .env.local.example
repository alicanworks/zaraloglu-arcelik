# Supabase — proje ayarları > API sayfasından alınır
# https://app.supabase.com/project/_/settings/api

# Tarayıcıya da gönderilir (public), sadece anon/public anahtarı kullanın.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sadece sunucu tarafında kullanılır (admin panel yazma işlemleri, RLS'i bypass eder).
# ASLA NEXT_PUBLIC_ ile başlatmayın / istemciye göndermeyin.
SUPABASE_SERVICE_ROLE_KEY=
